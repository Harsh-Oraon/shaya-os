#!/usr/bin/env bash
# shaya-fetch — SHAYA OS's own system info tool

# True-color (24-bit RGB) escape codes — immune to terminal theme remapping,
# unlike the standard 16-color \033[32m style codes.
GREEN='\033[38;2;0;200;60m'          # slightly softer than the bright accent
BRIGHT_GREEN='\033[38;2;0;255;65m'   # Matrix-style phosphor green
DIM='\033[2m'
RESET='\033[0m'

# --- Gather live system info ---
host=$(uname -n)
kernel=$(uname -r)
uptime_str=$(uptime -p 2>/dev/null | sed 's/^up //')
shell_name=$(basename "$SHELL")
pkg_count=$(pacman -Q 2>/dev/null | wc -l)

mem_total_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
mem_avail_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
mem_used_kb=$((mem_total_kb - mem_avail_kb))
mem_used_mb=$((mem_used_kb / 1024))
mem_total_mb=$((mem_total_kb / 1024))

cpu_model=$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo)

# --- Print it ---
printf "${BRIGHT_GREEN}"
cat << 'ART'
 ███████╗██╗  ██╗ █████╗ ██╗   ██╗ █████╗ 
 ██╔════╝██║  ██║██╔══██╗╚██╗ ██╔╝██╔══██╗
 ███████╗███████║███████║ ╚████╔╝ ███████║
 ╚════██║██╔══██║██╔══██║  ╚██╔╝  ██╔══██║
 ███████║██║  ██║██║  ██║   ██║   ██║  ██║
 ╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝
ART
printf "${RESET}${DIM}   Arch-based. Minimal. Yours to break.${RESET}\n\n"

line() {
  printf "  ${GREEN}%-10s${RESET} %s\n" "$1" "$2"
}

printf "${BRIGHT_GREEN}  ╭─────────────────────────────────────╮${RESET}\n"
line "OS"       "SHAYA OS (Arch-based)"
line "Host"     "$host"
line "Kernel"   "$kernel"
line "Uptime"   "${uptime_str:-just booted}"
line "Shell"    "$shell_name"
line "Packages" "$pkg_count"
line "CPU"      "$cpu_model"
line "Memory"   "${mem_used_mb}MB / ${mem_total_mb}MB"
printf "${BRIGHT_GREEN}  ╰─────────────────────────────────────╯${RESET}\n"
